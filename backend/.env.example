# Copy to .env and fill in secrets (never commit .env)
#   cp .env.example .env

# --- Database (Neon Serverless PostgreSQL or Docker) ---
# Neon (from Vercel Marketplace or neon.tech):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg2://noteorbit:noteorbit123@pgbouncer:5432/noteorbit

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
PASSWORD_SALT=noteorbit_salt_v1
ACCESS_TOKEN_EXPIRE_DAYS=7
DEFAULT_ADMIN_EMAIL=admin
DEFAULT_ADMIN_PASSWORD=admin

# --- Groq AI (Orbit Bot + academic insights) ---
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cloudflare R2 Object Storage (Notes, PDFs, Avatars) ---
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://870124513608cc25c2c6c85c38078b79.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
S3_REGION=auto
MINIO_DEFAULT_BUCKET=noteorbit
# Optional: if you attached a custom domain or pub-xxx.r2.dev to your R2 bucket:
# R2_PUBLIC_URL=https://pub-yourbucket.r2.dev

# --- SMTP (parent/faculty emails, notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info.noteorbit@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM=NoteOrbit <info.noteorbit@gmail.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Keep-Awake for Free Hosting (Render / Koyeb) ---
RENDER_EXTERNAL_URL=https://noteorbit-backend.onrender.com
KEEP_AWAKE=true
KEEP_AWAKE_INTERVAL_SECONDS=600

# --- CORS ---
CORS_ORIGINS=https://note-orbit.vercel.app,http://localhost:5173,http://127.0.0.1:5173
